{
  "expo": {
    "name": "Photo Damage Analyzer",
    "slug": "photo-damage-analyzer",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "photodamage",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.prototype.photodamageanalyzer"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2563EB"
      },
      "package": "com.prototype.photodamageanalyzer"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Photo Damage Analyzer to access your photos.",
          "cameraPermission": "Allow Photo Damage Analyzer to use your camera."
        }
      ],
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
