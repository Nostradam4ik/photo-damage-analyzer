# ── AI Provider ────────────────────────────────────────────────────────────────
# Set to "openai" or "anthropic". You must also supply the matching API key below.
# Setting only the API key is NOT sufficient — the provider must be explicitly set.
AI_PROVIDER=groq

# ── groq ─────────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Set to override the API endpoint — use for Groq, Azure OpenAI, local Ollama, etc.
# Leave unset to use the default OpenAI endpoint.
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# ── Anthropic ──────────────────────────────────────────────────────────────────
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-5

# ── Inference tuning ───────────────────────────────────────────────────────────
# Responses below this confidence will have needs_more_photos set to true.
CONFIDENCE_THRESHOLD=0.65
# AI_MAX_TOKENS=1024
# AI_TEMPERATURE=0.1

# ── File validation ────────────────────────────────────────────────────────────
MAX_IMAGE_SIZE_MB=10
MAX_IMAGE_DIMENSION=1024

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. In production, replace with your app's origin.
# CORS_ALLOWED_ORIGINS=https://your-app.example.com
